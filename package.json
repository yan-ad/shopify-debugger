{
  "name": "shopify-debugger",
  "version": "0.1.2",
  "description": "Local debugger and shim for Shopify Polaris App Bridge APIs.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/yan-ad/shopify-debugger.git"
  },
  "sideEffects": [
    "./dist/style.css",
    "./src/style.css"
  ],
  "workspaces": [
    "example"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./app-bridge-react": {
      "types": "./dist/app-bridge-react.d.ts",
      "import": "./dist/app-bridge-react.mjs",
      "require": "./dist/app-bridge-react.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently -n shell,playground -c cyan,magenta \"pnpm run dev:shell\" \"pnpm run dev:playground\"",
    "dev:shell": "vite --config vite.debugger-shell.config.ts",
    "dev:playground": "pnpm --filter example dev",
    "build": "pnpm run clean && pnpm run build:js && pnpm run build:types && pnpm run copy:css",
    "build:js": "vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "copy:css": "cp src/style.css dist/style.css",
    "release": "pnpm run check && pnpm run build && changelogen --release --push",
    "release:dry": "changelogen --dry",
    "release:publish": "pnpm run check && pnpm run build && changelogen --release --push --publish"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@shopify/polaris-types": "^1.0.7",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "changelogen": "^0.6.2",
    "concurrently": "^9.2.1",
    "path": "^0.12.7",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.1",
    "url": "^0.11.4",
    "vite": "^8.0.8"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0"
  }
}
