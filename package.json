{
  "name": "shopify-debugger",
  "version": "0.1.1",
  "description": "Local debugger and shim for Shopify Polaris App Bridge APIs.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/yan-ad/shopify-debugger.git"
  },
  "sideEffects": [
    "./dist/style.css",
    "./src/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./app-bridge-react": {
      "types": "./dist/app-bridge-react.d.ts",
      "import": "./dist/app-bridge-react.mjs",
      "require": "./dist/app-bridge-react.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run clean && bun run build:js && bun run build:types && bun run copy:css",
    "build:js": "vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "copy:css": "cp src/style.css dist/style.css",
    "release": "bun run check && bun run build && changelogen --release --push",
    "release:dry": "changelogen --dry",
    "release:publish": "bun run check && bun run build && changelogen --release --push --publish"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.2.37",
    "changelogen": "^0.6.2",
    "path": "^0.12.7",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.1",
    "url": "^0.11.4",
    "vite": "^^8.0.8"
  },
  "dependencies": {}
}
